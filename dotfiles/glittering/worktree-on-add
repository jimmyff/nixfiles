#!/bin/sh
# Nix-managed (source: ~/nixfiles/dotfiles/glittering/worktree-on-add).
# Symlinked to ~/.config/glittering/hooks/worktree/on-add by home-manager
# (home/shared/apps/ai.nix). Glittering runs it on `worktree add` with cwd =
# the new worktree. Seeds the new worktree with machine-local files from the
# base worktree, preserving symlinks (cp -P):
#   .mcp.json                    nix-managed symlink to the canonical MCP config
#   .claude/settings.local.json  accumulated Claude Code permission approvals
set -eu

for rel in .mcp.json .claude/settings.local.json; do
  src="$GLITTER_BASE_WORKTREE/$rel"
  dst="$GLITTER_WORKTREE_PATH/$rel"
  if [ -f "$src" ] || [ -L "$src" ]; then
    mkdir -p "$(dirname "$dst")"
    rm -f "$dst"        # never write through a pre-existing destination symlink
    cp -P "$src" "$dst" # -P: copy a symlink as a symlink (BSD + GNU compatible)
    echo "seeded $rel"
  fi
done
