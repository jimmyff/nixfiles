{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_TELEMETRY": "1",
    "USE_BUILTIN_RIPGREP": "0"
  },
  "attribution": {},
  "permissions": {
    "allow": [
      "WebFetch(domain:docs.cloud.google.com)",
      "WebFetch(domain:pub.dev)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:gitlab.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:wiki.nixos.org)",
      "WebFetch(domain:discourse.nixos.org)",
      "WebFetch(domain:nix-darwin.github.io)",
      "WebFetch(domain:www.nushell.sh)",
      "WebFetch(domain:json.schemastore.org)",
      "WebFetch(domain:www.schemastore.org)",
      "WebFetch(domain:starship.rs)",
      "WebFetch(domain:zellij.dev)",
      "WebFetch(domain:herdr.dev)",
      "WebSearch",
      "Edit(//tmp/**)",
      "Find(~/nixfiles/**)",
      "Read(~/nixfiles/**)",
      "Read(~/.pub-cache/**)",
      "Read(~/.cache/dart-pub/**)",
      "Read(~/.local/share/flutter/**)",
      "Read(~/.claude/**)",
      "Read(//nix/store/**)",
      "Read(//tmp/**)",
      "Read(//private/tmp/**)",
      "Bash(dart test:*)",
      "Bash(flutter test:*)",
      "Bash(dart run build_runner build:*)",
      "Bash(dart pub get:*)",
      "Bash(flutter pub get:*)",
      "Bash(dart analyze:*)",
      "Bash(flutter analyze:*)",
      "Bash(dart --version)",
      "Bash(flutter --version)",
      "Bash(dart format:*)",
      "Bash(flutter create:*)",
      "Bash(flutter config:*)",
      "Bash(flutter build:*)",
      "mcp__dart",
      "mcp__chrome-devtools",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go build:*)",
      "Bash(go mod tidy:*)",
      "Bash(go mod download:*)",
      "Bash(go fmt:*)",
      "Bash(go run:*)",
      "Bash(go get:*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(fd:*)",
      "Bash(tree:*)",
      "Bash(nu:*)",
      "Bash(timeout:*)",
      "Bash(kill:*)",
      "Bash(chmod:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git rev-list:*)",
      "Bash(git fetch:*)",
      "Bash(git remote:*)",
      "Bash(git submodule:*)",
      "Bash(git add:*)",
      "Bash(git checkout:*)",
      "Bash(git pull:*)",
      "Bash(git ls-files:*)",
      "Bash(git mv:*)",
      "Bash(git show:*)",
      "Bash(keytool:*)",
      "Bash(which:*)",
      "Read(~/.cache/glittering/**)",
      "Bash(glittering git:*)",
      "Bash(glittering git diff:*)",
      "Bash(glittering status:*)",
      "Bash(glittering test:*)",
      "Bash(glittering analyze:*)",
      "Bash(glittering get:*)",
      "Bash(glittering upgrade:*)",
      "Bash(glittering stats:*)",
      "Bash(glittering clean:*)",
      "Bash(glittering worktree:*)",
      "Bash(herdr:*)",
      "Bash(aerospace:*)",
      "Bash(zellij list-sessions:*)",
      "Bash(gh search:*)",
      "Bash(nix-instantiate:*)",
      "Bash(nix eval:*)",
      "Bash(nix derivation show:*)",
      "Bash(nix flake show:*)",
      "Bash(nix flake metadata:*)",
      "Bash(nix flake check:*)",
      "Bash(nix-store --query:*)",
      "Bash(nix path-info:*)",
      "Bash(nix why-depends:*)",
      "Bash(nix search:*)",
      "Bash(nix-env --query:*)",
      "Bash(nix-env -q:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)"
    ],
    "ask": [
      "Bash(rm:*)",
      "Bash(git reset:*)",
      "Bash(git clean:*)"
    ]
  },
  "model": "opus",
  "enabledMcpjsonServers": [
    "dart",
    "chrome-devtools"
  ],
  "hooks": {},
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0,
    "refreshInterval": 60
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "filesystem": {
      "allowWrite": [
        "~/.pub-cache",
        "~/.cache/dart-pub"
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "~/.aws",
          "mode": "deny"
        },
        {
          "path": "~/.config/gcloud",
          "mode": "deny"
        },
        {
          "path": "~/.config/gh",
          "mode": "deny"
        },
        {
          "path": "~/.config/sops/age",
          "mode": "deny"
        }
      ],
      "envVars": [
        {
          "name": "GITHUB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GH_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GOOGLE_APPLICATION_CREDENTIALS",
          "mode": "deny"
        },
        {
          "name": "SOPS_AGE_KEY",
          "mode": "deny"
        },
        {
          "name": "SOPS_AGE_KEY_FILE",
          "mode": "deny"
        }
      ]
    },
    "excludedCommands": [
      "git push",
      "git push *",
      "git pull",
      "git pull *",
      "git fetch",
      "git fetch *",
      "git clone *",
      "git ls-remote *",
      "git remote update",
      "git remote update *",
      "git submodule update",
      "git submodule update *",
      "glittering *",
      "aerospace",
      "aerospace *",
      "gcloud *",
      "gsutil *",
      "gh *",
      "docker *",
      "firebase *",
      "flutterfire *"
    ],
    "allowedDomains": [
      "pub.dev",
      "storage.googleapis.com",
      "cache.nixos.org"
    ]
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "autoMemoryEnabled": false,
  "autoDreamEnabled": false,
  "theme": "dark-daltonized",
  "autoCompactEnabled": false
}
